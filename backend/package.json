{
  "name": "@dbi/backend",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node -r ts-node/register --test test/*.test.ts",
    "db:check": "node --env-file-if-exists=.env -r ts-node/register src/check-database.ts",
    "db:generate": "node --env-file-if-exists=.env ../node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env ../node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.7.1",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.11",
    "ts-node": "^10.9.2"
  }
}
