# Only required when using PostgreSQL. Supply your own database credentials.
# Set to production in deployments; Swagger is hidden by default in production.
# NODE_ENV=production
DATABASE_URL=postgresql://dbi:replace-me@127.0.0.1:5432/dbiskillsnetwork
# Optional: defaults to http://localhost:3000
# APP_ORIGIN=https://your-domain.example
# Required to enable access-token issuance. Use a random value of at least 32 bytes.
# AUTH_ACCESS_TOKEN_SECRET=
# Optional: enable Google Identity Services; set the same public client ID as
# NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend's Render build environment.
# GOOGLE_CLIENT_ID=
# Required to enable verification email delivery.
# BREVO_API_KEY=
# BREVO_FROM_EMAIL=
# BREVO_FROM_NAME=DBI Skills Network
# Optional legal consent version identifiers (default: v1).
# TERMS_VERSION=v1
# PRIVACY_VERSION=v1
# Set to false to hide API docs outside production, or true to intentionally expose them in production.
# SWAGGER_ENABLED=
# Optional: Neon Object Storage (S3-compatible via files-sdk/neon; pull with `neon env pull -s object-storage`).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
# NEON_STORAGE_BUCKET=uploads
